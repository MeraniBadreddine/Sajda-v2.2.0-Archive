<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#330A84FF" />
            <stroke android:width="0.5dp" android:color="#550A84FF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="100dp" android:topRightRadius="100dp" />
            <gradient android:angle="270" android:startColor="#30FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
