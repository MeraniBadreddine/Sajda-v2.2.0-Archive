<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#18FFFFFF" />
        </shape>
    </item>
    <item android:left="0.5dp" android:top="0.5dp" android:right="0.5dp" android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#CC1C1C1E" />
            <stroke android:width="0.5dp" android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="100dp" android:topRightRadius="100dp" />
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
