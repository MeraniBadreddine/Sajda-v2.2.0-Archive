<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/brandBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S A J D A"
            android:textColor="#59EBEBF5"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.42"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/tagline"
            android:textColor="#33EBEBF5"
            android:textSize="10sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btnInfoWrap"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/about_title"
        app:layout_constraintTop_toTopOf="@id/brandBlock"
        app:layout_constraintBottom_toBottomOf="@id/brandBlock"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnInfo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_liquid_glass_circle"
            android:gravity="center"
            android:text="i"
            android:textColor="@color/label_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" />
    </FrameLayout>

    <TextView
        android:id="@+id/degreeText"
        style="@style/SajdaDegree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/brandBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/deltaText"
        style="@style/SajdaBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:minHeight="20dp"
        android:maxLines="2"
        app:layout_constraintTop_toBottomOf="@id/degreeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.sajda.ui.CompassView
        android:id="@+id/compass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/deltaText"
        app:layout_constraintBottom_toTopOf="@id/statusStack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <LinearLayout
        android:id="@+id/statusStack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/calibrateBanner"
            style="@style/SajdaFootnote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_liquid_glass_banner"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/accent"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/confidenceText"
            style="@style/SajdaFootnote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_liquid_glass_pill"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/hintText"
            style="@style/SajdaCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/locationPill"
            style="@style/SajdaCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_liquid_glass_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/label_secondary"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/locationText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
