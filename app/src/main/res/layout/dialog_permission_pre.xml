<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_liquid_glass_card"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_pre_title"
        android:textColor="@color/label_primary"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/permission_pre_body"
        android:textColor="@color/label_secondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.25"
        android:fontFamily="sans-serif"
        android:gravity="center" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="18dp"
        android:background="#28FFFFFF" />

    <TextView
        android:id="@+id/permContinue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/permission_pre_continue"
        android:textColor="@color/accent"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/permNotNow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/permission_pre_not_now"
        android:textColor="@color/label_secondary"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
